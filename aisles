local bannerVersion = 0

local function alert(name, model, message)
    if not running or not GLOBAL_ALERTS then return end
    if not CONFIG[name] or not CONFIG[name].Alert then return end

    local key = name .. "_" .. model:GetFullName()
    local now = os.clock()

    if now - (lastAlert[key] or -math.huge) < ALERT_COOLDOWN then
        return
    end

    lastAlert[key] = now
    bannerVersion += 1
    local version = bannerVersion

    banner.Text = message
    banner.BackgroundColor3 = CONFIG[name].Color
    banner.Visible = true

    pcall(function()
        sound:Play()
    end)

    task.delay(2, function()
        if running and bannerVersion == version then
            banner.Visible = false
        end
    end)
end

--============================================================
-- CHARACTER HELPERS
--============================================================

local function rootOf(character)
    if not character then return nil end

    return character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("Torso")
end

local function aliveCharacter(character)
    local hum = character
        and character:FindFirstChildOfClass("Humanoid")

    return hum and hum.Health > 0
end

local function closestPlayerTo(position)
    local bestPlayer
    local bestDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        local character = player.Character
        local root = rootOf(character)

        if root and aliveCharacter(character) then
            local d = (root.Position - position).Magnitude
            local head = character:FindFirstChild("Head")

            if head then
                d = math.min(
                    d,
                    (head.Position - position).Magnitude
                )
            end

            if d < bestDistance then
                bestPlayer = player
                bestDistance = d
            end
        end
    end

    return bestPlayer, bestDistance
end

local function sniperTargetsUs(model)
    if model:GetAttribute("State") ~= "Aiming" then
        return false
    end

    local aim = model:GetAttribute("AimPosition")

    if typeof(aim) ~= "Vector3" then
        return false
    end

    local player, distance = closestPlayerTo(aim)

    return player == LP
        and distance ~= math.huge
        and distance <= CONFIG.Sniper.AimTolerance
end

--============================================================
-- ESP
--============================================================

local function removeESP(obj)
    local data = espObjects[obj]
    if not data then return end

    pcall(function()
        data.highlight:Destroy()
    end)

    pcall(function()
        data.billboard:Destroy()
    end)

    espObjects[obj] = nil
end

local function getAdornee(obj)
    if obj:IsA("Model") or obj:IsA("BasePart") then
        return obj
    end

    return nil
end

local function getLabelPart(obj)
    if obj:IsA("BasePart") then
        return obj
    elseif obj:IsA("Model") then
        return obj:FindFirstChild("Head")
            or obj:FindFirstChild("HumanoidRootPart")
            or obj.PrimaryPart
            or obj:FindFirstChildWhichIsA("BasePart", true)
    end

    return obj:FindFirstChildWhichIsA("BasePart", true)
end

local function addESP(obj, name, labelText, color)
    if espObjects[obj] then return end

    local adornee = getAdornee(obj)
    if not adornee then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "LocalESPHighlight"
    highlight.Adornee = adornee
    highlight.FillColor = color
    highlight.OutlineColor = color
    highlight.FillTransparency = 0.78
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = gui

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "LocalESPLabel"
    billboard.Adornee = getLabelPart(obj)
    billboard.Size = UDim2.fromOffset(170, 27)
    billboard.StudsOffset = Vector3.new(0, 2.8, 0)
    billboard.AlwaysOnTop = true
    billboard.Enabled = billboard.Adornee ~= nil
    billboard.Parent = gui

    local text = Instance.new("TextLabel")
    text.Size = UDim2.fromScale(1, 1)
    text.BackgroundTransparency = 1
    text.Text = labelText
    text.TextColor3 = color
    text.TextStrokeTransparency = 0.15
    text.Font = Enum.Font.GothamBold
    text.TextSize = 14
    text.Parent = billboard

    espObjects[obj] = {
        highlight = highlight,
        billboard = billboard,
        name = name,
    }
end

local function getFolder(name)
    return workspace:FindFirstChild(CONFIG[name].Folder)
end

local function collectEnemyModels(name)
    local folder = getFolder(name)
    local result = {}

    if not folder then return result end

    for _, obj in ipairs(folder:GetChildren()) do
        if obj:IsA("Model") then
            table.insert(result, obj)
        end
    end

    return result
end

local function collectMines()
    local folder = workspace:FindFirstChild(CONFIG.Landmine.Folder)
    local result = {}

    if not folder then return result end

    for _, obj in ipairs(folder:GetDescendants()) do
        if obj:IsA("Model") then
            table.insert(result, obj)
        elseif obj:IsA("BasePart")
            and not obj:FindFirstAncestorOfClass("Model") then

            table.insert(result, obj)
        end
    end

    for _, obj in ipairs(folder:GetChildren()) do
        if obj.Name == "Landmine"
            and (obj:IsA("Model") or obj:IsA("BasePart")) then

            table.insert(result, obj)
        end
    end

    return result
end

--============================================================
-- MAIN SCAN
--============================================================

task.spawn(function()
    while running do
        local character = LP.Character
        local myRoot = rootOf(character)
        local activeObjects = {}

        for _, name in ipairs({"Sniper", "Rifleman", "Angel"}) do
            local cfg = CONFIG[name]

            for _, model in ipairs(collectEnemyModels(name)) do
                activeObjects[model] = true

                if cfg.ESP then
                    addESP(model, name, name, cfg.Color)
                else
                    removeESP(model)
                end

                local enemyRoot = rootOf(model) or model.PrimaryPart

                if enemyRoot and myRoot and aliveCharacter(character) then
                    local distance =
                        (enemyRoot.Position - myRoot.Position).Magnitude

                    if name == "Sniper" then
                        if sniperTargetsUs(model) then
                            alert(
                                name,
                                model,
                                "⚠️ SNIPER AIMING AT YOU!"
                            )
                        end
                    elseif cfg.Proximity > 0
                        and distance <= cfg.Proximity then

                        alert(
                            name,
                            model,
                            "⚠️ " .. string.upper(name)
                                .. " NEARBY [" .. math.floor(distance)
                                .. " studs]"
                        )
                    end
                end
            end
        end

        for _, mine in ipairs(collectMines()) do
            activeObjects[mine] = true

            if CONFIG.Landmine.ESP then
                addESP(
                    mine,
                    "Landmine",
                    "⚠️ LANDMINE",
                    CONFIG.Landmine.Color
                )
            else
                removeESP(mine)
            end
        end

        for obj in pairs(espObjects) do
            if not obj.Parent or not activeObjects[obj] then
                removeESP(obj)
            end
        end

        task.wait(SCAN_INTERVAL)
    end
end)

