--============================================================
-- LIGHTING TOGGLE
--============================================================

local lightingEnabled = false
local lightingConnections = {}
local originalLighting = {}

local lightingProperties = {
    "Brightness",
    "ClockTime",
    "ExposureCompensation",
    "GlobalShadows",
    "Ambient",
    "OutdoorAmbient",
    "FogEnd",
}

local function captureOriginalLighting()
    for _, property in ipairs(lightingProperties) do
        pcall(function()
            originalLighting[property] = Lighting[property]
        end)
    end
end

captureOriginalLighting()

local function applyLighting()
    if not lightingEnabled then
        return
    end

    pcall(function()
        Lighting.Brightness = 3
        Lighting.ClockTime = 14
        Lighting.ExposureCompensation = 0.25
        Lighting.GlobalShadows = true
        Lighting.Ambient = Color3.fromRGB(140, 140, 140)
        Lighting.OutdoorAmbient = Color3.fromRGB(170, 170, 170)
        Lighting.FogEnd = 100000
    end)
end

local function stopLightingWatchers()
    for _, connection in ipairs(lightingConnections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(lightingConnections)
end

local function setLightingEnabled(enabled)
    lightingEnabled = enabled
    stopLightingWatchers()

    if enabled then
        applyLighting()

        for _, property in ipairs(lightingProperties) do
            local connection =
                Lighting:GetPropertyChangedSignal(property):Connect(function()
                    if lightingEnabled then
                        task.defer(applyLighting)
                    end
                end)

            table.insert(lightingConnections, connection)
        end
    else
        for property, value in pairs(originalLighting) do
            pcall(function()
                Lighting[property] = value
            end)
        end
    end

    if buttons.Lighting then
        buttons.Lighting.Text = lightingEnabled
            and "☑️ Lighting: ON"
            or "☐ Lighting: OFF"

        buttons.Lighting.BackgroundColor3 = lightingEnabled
            and Color3.fromRGB(40, 95, 75)
            or Color3.fromRGB(43, 47, 61)
    end
end

buttons.Lighting = makeButton("☐ Lighting: OFF", function()
    setLightingEnabled(not lightingEnabled)
end)

