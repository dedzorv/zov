local function updateButton(name, kind)
    local b = buttons[name .. kind]
    if not b then return end

    local enabled = CONFIG[name][kind]
    local label = kind == "Alert" and "Notifications" or "ESP"

    b.Text = name .. " | " .. label .. ": "
        .. (enabled and "ON" or "OFF")

    b.BackgroundColor3 = enabled
        and Color3.fromRGB(40, 95, 75)
        or Color3.fromRGB(55, 48, 55)
end

